{
  "name": "vitest-auto-spies",
  "version": "3.12.0",
  "description": "Alias of vitest-auto-spy — auto-generate fully-typed test spies from a class across Vitest, Bun and node:test, with RxJS/Angular/NestJS/React/Vue/Svelte recipes. Install vitest-auto-spy (singular) directly; this package re-exports it.",
  "keywords": [
    "vitest-auto-spies",
    "vitest-auto-spy",
    "auto-spies",
    "auto-spy",
    "auto-mock",
    "jest-auto-spies",
    "vitest",
    "bun",
    "node-test",
    "testing",
    "spy",
    "mock",
    "rxjs",
    "typescript"
  ],
  "license": "MIT",
  "author": "Alexey Popov <asdalexey@yandex.ru>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ASDAlexey/vitest-auto-spy.git",
    "directory": "alias"
  },
  "homepage": "https://github.com/ASDAlexey/vitest-auto-spy#readme",
  "bugs": {
    "url": "https://github.com/ASDAlexey/vitest-auto-spy/issues"
  },
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./bun": {
      "types": "./bun.d.ts",
      "import": "./bun.js",
      "default": "./bun.js"
    },
    "./bun-angular": {
      "types": "./bun-angular.d.ts",
      "import": "./bun-angular.js",
      "default": "./bun-angular.js"
    },
    "./node": {
      "import": {
        "types": "./node.d.ts",
        "default": "./node.js"
      },
      "require": {
        "types": "./node.d.cts",
        "default": "./node.cjs"
      }
    },
    "./rxjs": {
      "types": "./rxjs.d.ts",
      "import": "./rxjs.js",
      "default": "./rxjs.js"
    },
    "./console": {
      "types": "./console.d.ts",
      "import": "./console.js",
      "default": "./console.js"
    },
    "./angular": {
      "types": "./angular.d.ts",
      "import": "./angular.js",
      "default": "./angular.js"
    },
    "./nestjs": {
      "types": "./nestjs.d.ts",
      "import": "./nestjs.js",
      "default": "./nestjs.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./react.js",
      "default": "./react.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "import": "./vue.js",
      "default": "./vue.js"
    },
    "./svelte": {
      "types": "./svelte.d.ts",
      "import": "./svelte.js",
      "default": "./svelte.js"
    },
    "./setup": {
      "types": "./setup.d.ts",
      "import": "./setup.js",
      "default": "./setup.js"
    },
    "./zone": {
      "types": "./zone.d.ts",
      "import": "./zone.js",
      "default": "./zone.js"
    },
    "./eslint-plugin": {
      "import": {
        "types": "./eslint-plugin.d.ts",
        "default": "./eslint-plugin.js"
      },
      "require": {
        "types": "./eslint-plugin.d.cts",
        "default": "./eslint-plugin.cjs"
      }
    }
  },
  "files": [
    "*.js",
    "*.cjs",
    "*.d.ts",
    "*.d.cts",
    "README.md"
  ],
  "dependencies": {
    "vitest-auto-spy": "^3.12.0"
  },
  "peerDependencies": {
    "@angular/core": ">=16.0.0",
    "rxjs": ">=7.0.0",
    "vitest": ">=2.1.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./index.js",
    "./bun.js",
    "./bun-angular.js",
    "./node.js",
    "./node.cjs",
    "./rxjs.js",
    "./console.js",
    "./angular.js",
    "./nestjs.js",
    "./react.js",
    "./vue.js",
    "./svelte.js",
    "./setup.js",
    "./zone.js",
    "./eslint-plugin.js",
    "./eslint-plugin.cjs"
  ]
}
